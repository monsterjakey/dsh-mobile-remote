{
  "name": "dsh-mobile-remote",
  "version": "0.3.0",
  "type": "module",
  "description": "Mobile skin, left-sidebar remote panel and pairing helper for the official DSH Web UI (Tailscale transport)",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.2-0 <0.3.0"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote",
    "mobile",
    "tailscale",
    "iphone",
    "ipad"
  ],
  "author": {
    "name": "monsterjakey"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/monsterjakey/dsh-mobile-remote.git"
  },
  "homepage": "https://github.com/monsterjakey/dsh-mobile-remote",
  "bugs": {
    "url": "https://github.com/monsterjakey/dsh-mobile-remote/issues"
  }
}
